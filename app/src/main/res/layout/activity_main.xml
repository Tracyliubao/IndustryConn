<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tv_store"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@color/teal_700"
            android:text="本地存储"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/tv_serial"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="串口操作"
            android:gravity="center"
            android:background="@color/purple_200"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_store"
            >



        </TextView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_content3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_serial"
            >

            <TextView
                android:id="@+id/tv_scan"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:background="@color/teal_200"
                android:text="开始扫描"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_device_list"
                android:layout_width="220dp"
                android:layout_height="200dp"
                android:textSize="16sp"
                android:layout_marginLeft="20dp"
                android:hint="扫描到的BLE设备将显示在这里..."
                android:background="@color/purple_200"
                app:layout_constraintStart_toEndOf="@id/tv_scan"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/tv_device_info"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:background="@color/teal_200"
                android:hint="设备信息"
                android:gravity="center"
                android:layout_marginLeft="20dp"
                app:layout_constraintStart_toEndOf="@id/rv_device_list"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/tv_write_char"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:background="@color/purple_200"
                android:text="写入特征值"
                android:gravity="center"
                android:layout_marginLeft="20dp"
                app:layout_constraintStart_toEndOf="@id/tv_device_info"
                app:layout_constraintTop_toTopOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_content3">

        <TextView
            android:id="@+id/tv_tcp"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@color/purple_200"
            android:gravity="center"
            android:hint="TCP连接状态"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/tv_udp"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@color/teal_200"
            android:gravity="center"
            android:hint="Udp发送：Hello"
            android:layout_marginLeft="20dp"
            app:layout_constraintStart_toEndOf="@id/tv_tcp"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/tv_udp_content"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:background="@color/teal_200"
            android:gravity="center"
            android:hint="接收UDP消息"
            android:layout_marginLeft="20dp"
            app:layout_constraintStart_toEndOf="@id/tv_udp"
            app:layout_constraintTop_toTopOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>